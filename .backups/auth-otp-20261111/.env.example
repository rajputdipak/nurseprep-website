# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: lets the server email all admin accounts on new UTR submissions
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Your app URL (email confirmation redirect and payment email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- PAYMENT EMAIL NOTIFICATIONS ----------
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=youraddress@gmail.com, SMTP_PASS=<16-character app password>.
# Leave these empty to disable email alerts; payments still work.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NursePrep <youraddress@gmail.com>

# Optional: comma-separated admin recipients. When set, admin lookup is skipped
# and the service-role key is not needed.
ADMIN_NOTIFICATION_EMAIL=
